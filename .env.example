# ---------------------------------------------------------------------------
# speech-bridge configuration — copy to `.env` and edit.
# Priority: process env vars > .env > config.yaml > built-in defaults.
# ---------------------------------------------------------------------------

# --- Subsystem toggles (partial modes: STT-only / TTS-only / both) ---------
ENABLE_STT=true
ENABLE_TTS=true

# --- Engine selection: local | azure | openai | aws -------------------------
STT_ENGINE=local
TTS_ENGINE=local

# --- Local STT (faster-whisper) ---------------------------------------------
# Model size/name: tiny, base, small, medium, large-v2, large-v3, ...
# Tip: use "small" or "medium" for low-latency live streaming on CPU.
STT_LOCAL_MODEL_SIZE=large-v3
# auto | cuda | cpu   ("auto" uses CUDA when available)
STT_LOCAL_DEVICE=auto
# auto | float16 | int8 | int8_float16 | float32  ("auto": GPU->float16, CPU->int8)
STT_LOCAL_COMPUTE_TYPE=auto
STT_LOCAL_BEAM_SIZE=5

# --- Live-streaming STT tuning ----------------------------------------------
STT_STREAM_INFER_INTERVAL_SECONDS=1.5
STT_STREAM_MAX_SEGMENT_SECONDS=12.0
STT_STREAM_SILENCE_RMS_THRESHOLD=300
STT_STREAM_TRAILING_SILENCE_SECONDS=0.6
STT_STREAM_OPENAI_FLUSH_SECONDS=3.0

# --- Local TTS ---------------------------------------------------------------
# edge (default; zero-cost neural voices incl. Hebrew/Arabic) | coqui (offline)
TTS_LOCAL_BACKEND=edge
TTS_COQUI_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
TTS_COQUI_SPEAKER=Ana Florence

# --- Azure Speech Services (STT_ENGINE=azure / TTS_ENGINE=azure) -------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- OpenAI (STT_ENGINE=openai / TTS_ENGINE=openai) ---------------------------
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# --- AWS (STT_ENGINE=aws / TTS_ENGINE=aws) ------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# neural | standard (Polly voice engine)
AWS_POLLY_ENGINE=neural

# --- Security: authentication & rate limiting ---------------------------------
# Require an X-API-Key header on every /api/v1 route + the live WS handshake.
ENABLE_AUTH=false
# Comma-separated accepted keys, e.g. API_KEYS=key1,key2
API_KEYS=
API_KEY_HEADER=X-API-Key
# Rate limit shared by REST + WebSocket. "<n>/<period>", empty disables.
ENABLE_RATE_LIMIT=true
RATE_LIMIT=60/minute
# Request caps (also cost guards for the paid remote APIs)
MAX_UPLOAD_BYTES=26214400        # 25 MiB per /transcribe upload
MAX_TEXT_CHARS=5000              # per /synthesize request
MAX_WS_SESSION_SECONDS=300       # live-transcribe hard time cap
MAX_WS_BYTES=104857600           # live-transcribe total audio cap (100 MiB)
# CORS: comma-separated origins or "*". Empty disables cross-origin.
CORS_ALLOW_ORIGINS=

# --- Secrets backend (resolve credentials from a cloud secret manager) --------
# none | aws | azure | gcp | oci
SECRETS_BACKEND=none
# aws: name prefix ("speech-bridge/") · gcp: "projects/<id>"
# azure: Key Vault URL · oci: Vault OCID
SECRETS_PREFIX=

# --- Observability ------------------------------------------------------------
ENABLE_METRICS=true                    # Prometheus /metrics
OTEL_EXPORTER_OTLP_ENDPOINT=           # e.g. http://otel-collector:4318 (empty = off)
OTEL_SERVICE_NAME=speech-bridge

# --- Server -------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Empty -> <system temp>/speech_engine
TEMP_DIR=
